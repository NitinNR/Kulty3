MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kulty
PORT=5000

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret

# REQUIRED for POST /api/payments/webhook to verify anything.
# Set this to the "Secret" you generate when adding the webhook endpoint in
# Razorpay Dashboard → Settings → Webhooks. Without it the endpoint rejects
# every event with HTTP 500 and no membership is ever activated by webhook.
# Subscribe to: payment.captured, payment.failed, refund.processed,
#               charge.dispute.created
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

NODE_ENV=development

# Comma-separated list of allowed frontend origins (for CORS)
# Vercel preview URLs are auto-allowed via VERCEL_URL env var
FRONTEND_URLS=https://kulty.in,https://www.kulty.in

# OPTIONAL — enables the scheduled bulk payment reconciler.
# GET/POST /api/admin/payments/reconcile accepts this as a bearer token so a
# scheduler (e.g. a Vercel cron) can recover captured-but-unactivated payments
# without an admin login. Note: recovery ALSO runs automatically per-user on
# GET /api/payments/my, so this is only needed for a proactive sweep.
# If unset, the endpoint still works for logged-in admins.
CRON_SECRET=your-random-cron-secret
