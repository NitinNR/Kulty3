MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kulty
PORT=5000

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# MSG91 OTP Widget — account authkey used server-side to verify OTPs and the
# access token returned by the widget. (https://control.msg91.com → Settings → Authkey)
MSG91_AUTHKEY=your-msg91-authkey

# MSG91 OTP Widget id (same value as the frontend VITE_MSG91_WIDGET_ID).
# Used with /widget/retryOtp and /widget/verifyOtp. Not a secret.
MSG91_WIDGET_ID=your-msg91-widget-id

NODE_ENV=development

# Comma-separated list of allowed frontend origins (for CORS)
# Vercel preview URLs are auto-allowed via VERCEL_URL env var
FRONTEND_URLS=https://kulty.in,https://www.kulty.in
